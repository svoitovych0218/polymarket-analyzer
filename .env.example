# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — used by the LLM grouper (Claude Haiku)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────────

# LLM provider: "claude" (default) or "openai"
# LLM_PROVIDER=claude

# Model name for the selected provider. Defaults to claude-haiku-4-5-20251001
# (claude) or gpt-4o-mini (openai). Must be a model the chosen provider accepts.
# LLM_MODEL=claude-sonnet-5-5

# OpenAI API key — only required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Delay between LLM calls in milliseconds (default: 0)
# Set to 3000 when using OpenAI free/tier-1 to avoid 429 rate limit errors
# LLM_CALL_DELAY_MS=3000

# Max markets per LLM call (default: 50)
# Reduce to 20–30 when using OpenAI to avoid 400 context-limit errors on large buckets
# BUCKET_CHUNK_SIZE=30

# Path to the NDJSON mismatch log file
# Default: data/mismatches.ndjson
# MISMATCH_LOG_PATH=data/mismatches.ndjson

# Minimum LLM confidence score required to persist a group (default: 0.80)
# Groups proposed with confidence below this threshold are silently discarded.
# Raise toward 1.0 for higher precision; lower toward 0.5 for higher recall.
# MIN_GROUP_CONFIDENCE=0.80
